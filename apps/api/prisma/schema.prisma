generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  readonly
  operator
  admin
}

enum DeviceOnlineStatus {
  online
  offline
  unknown
}

enum DeviceFaultStatus {
  normal
  fault
  unknown
}

enum AlertStatus {
  open
  acked
  closed
}

model AdminUser {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         AdminRole
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  commandLogs  CommandLog[]
  opsReports   OpsReport[]
}

model EndUser {
  id            String          @id @default(cuid())
  tuyaUid       String          @unique
  username      String?
  nickName      String?
  mobile        String?
  email         String?
  countryCode   String?
  timeZoneId    String?
  tempUnit      Int?
  avatar        String?         @db.VarChar(512)
  cloudCreatedAt DateTime?
  cloudUpdatedAt DateTime?
  remark        String?         @db.VarChar(512)
  raw           Json?
  syncedAt      DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bindings      DeviceBinding[]
}

model Device {
  id             String             @id @default(cuid())
  deviceId       String             @unique
  productId      String
  name           String?
  onlineStatus   DeviceOnlineStatus @default(unknown)
  statusJson     Json?
  faultStatus    DeviceFaultStatus  @default(unknown)
  faultInfo      String?            @db.VarChar(512)
  lat            String?
  lon            String?
  locationText   String?            @db.VarChar(128)
  signalStrength String?            @db.VarChar(64)
  activatedAt    DateTime?
  lastSeenAt     DateTime?
  syncedAt       DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  bindings       DeviceBinding[]
  events         DeviceEvent[]
  commandLogs    CommandLog[]
  alerts         Alert[]

  @@index([productId])
  @@index([onlineStatus])
  @@index([faultStatus])
}

model DeviceBinding {
  id         String   @id @default(cuid())
  deviceId   String
  endUserId  String
  boundAt    DateTime?
  syncedAt   DateTime @default(now())
  device     Device   @relation(fields: [deviceId], references: [id])
  endUser    EndUser  @relation(fields: [endUserId], references: [id])

  @@unique([deviceId, endUserId])
  @@index([endUserId])
}

model DeviceEvent {
  id        String   @id @default(cuid())
  deviceId  String
  bizCode   String
  payload   Json
  eventTime DateTime
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id])

  @@index([deviceId, eventTime])
  @@index([bizCode, eventTime])
  @@index([eventTime])
}

model CommandLog {
  id           String   @id @default(cuid())
  deviceId     String
  adminUserId  String
  productId    String
  code         String
  value        Json
  tuyaResponse Json?
  success      Boolean  @default(false)
  createdAt    DateTime @default(now())
  device       Device   @relation(fields: [deviceId], references: [id])
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([deviceId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  resource    String
  detail      Json?
  createdAt   DateTime @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([createdAt])
}

model Alert {
  id                 String      @id @default(cuid())
  deviceId           String
  source             String
  title              String
  detail             Json?
  status             AlertStatus @default(open)
  openedAt           DateTime    @default(now())
  closedAt           DateTime?
  category           String?     @db.VarChar(32)
  faultCode          String?     @db.VarChar(64)
  fingerprint        String?     @db.VarChar(191)
  /// Non-null only while open/acked. Multiple NULLs are allowed; never store ''.
  activeKey          String?     @unique @db.VarChar(191)
  conditionStartedAt DateTime?
  occurrenceCount    Int         @default(1)
  lastSeenAt         DateTime?
  closedReason       String?     @db.VarChar(32)
  device             Device      @relation(fields: [deviceId], references: [id])

  @@index([status, openedAt])
  @@index([deviceId, status])
  @@index([deviceId, faultCode, status])
  @@index([category, status])
}

/// Product fault-code dictionary. Matched copy is seeded from panel fault meanings.
model FaultCodeDefinition {
  id                 String   @id @default(cuid())
  productId          String   @db.VarChar(64)
  code               String   @db.VarChar(64)
  label              String   @db.VarChar(64)
  sortOrder          Int      @default(0)
  symptom            String?  @db.VarChar(256)
  cause              String?  @db.VarChar(256)
  suggestedAction    String?  @db.VarChar(256)
  countInQualityRate Boolean  @default(true)
  notifyAftersales   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([productId, code, label])
}

/// Shared fault-code dictionary. Member products keep their own FaultCodeDefinition rows.
model FaultCodeGroup {
  id        String                 @id @default(cuid())
  name      String                 @db.VarChar(128)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  members   FaultCodeGroupMember[]
  codes     FaultCodeGroupCode[]
}

model FaultCodeGroupMember {
  groupId   String         @db.VarChar(191)
  productId String         @unique @db.VarChar(64)
  group     FaultCodeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, productId])
}

model FaultCodeGroupCode {
  id                 String         @id @default(cuid())
  groupId            String
  code               String         @db.VarChar(64)
  label              String         @db.VarChar(64)
  sortOrder          Int            @default(0)
  symptom            String?        @db.VarChar(256)
  cause              String?        @db.VarChar(256)
  suggestedAction    String?        @db.VarChar(256)
  countInQualityRate Boolean        @default(true)
  notifyAftersales   Boolean        @default(false)
  group              FaultCodeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, code, label])
}

model DpAlias {
  id        String   @id @default(cuid())
  productId String
  code      String
  alias     String
  groupName String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, code])
  @@index([productId])
}

/// Daily device online/offline/fault snapshot. Not purged by RetentionJob.
/// productId empty string = fleet-wide total.
model DailyDeviceMetric {
  id            String   @id @default(cuid())
  day           String
  productId     String   @default("")
  onlineCount   Int      @default(0)
  offlineCount  Int      @default(0)
  faultCount    Int      @default(0)
  totalDevices  Int      @default(0)
  modeCounts    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([day, productId])
  @@index([day])
}

/// Daily fault / alert rollup by fault code. Not purged by RetentionJob.
model DailyFaultStat {
  id              String   @id @default(cuid())
  day             String
  productId       String   @default("")
  faultCode       String
  openCount       Int      @default(0)
  newCount        Int      @default(0)
  closedCount     Int      @default(0)
  mttrMinutesAvg  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([day, productId, faultCode])
  @@index([day])
  @@index([faultCode])
}

enum OpsReportTemplate {
  week
  month
  custom
}

enum OpsReportStatus {
  pending
  ready
  failed
}

/// Generated ops report (week/month/custom). Not purged by RetentionJob.
model OpsReport {
  id                   String           @id @default(cuid())
  name                 String
  template             OpsReportTemplate
  startDay             String
  endDay               String
  productId            String?
  sections             Json
  status               OpsReportStatus  @default(pending)
  resultJson           Json?
  csvText              String?          @db.LongText
  error                String?          @db.VarChar(1024)
  createdByAdminUserId String
  createdAt            DateTime         @default(now())
  completedAt          DateTime?
  createdBy            AdminUser        @relation(fields: [createdByAdminUserId], references: [id])

  @@index([createdAt])
  @@index([status])
}
