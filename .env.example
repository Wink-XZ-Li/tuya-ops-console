# Runtime profile. demo: local demo health still flags a mock Tuya client.
# production: system health does not treat DEMO_MODE=mock as an outage.
APP_PROFILE=demo

# Tuya client only. mock → TuyaMockClient, live → TuyaLiveClient.
# This does not cap sync or Kafka ingest.
DEMO_MODE=mock
# mock | live

# Web badge (mirrors DEMO_MODE; vite.config also reads root DEMO_MODE)
VITE_DEMO_MODE=mock

# Production fleet warning line. Unset defaults to 10000.
# 0, none, unlimited, or off = no cap.
# Crossing the cap logs device_soft_cap and still accepts the device.
# There is no hardcoded ingest cap of 50.
# DEVICE_SOFT_CAP=10000

# Mock seed ceiling only (pnpm seed:mock / pnpm demo:mock). Not read by sync or Kafka.
DEMO_SEED_DEVICE_CAP=50

DATABASE_URL=mysql://ops:ops@127.0.0.1:3306/tuya_ops
JWT_SECRET=local-demo-secret
JWT_EXPIRES_IN=12h

TUYA_BASE_URL=https://openapi.tuyacn.com
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# 产品白名单已取消。同步会拉取云项目下的设备，不受写死的 50 台上限约束。
# TUYA_PRODUCT_IDS=
# App 渠道标识符（用户页「同步用户」→ GET /v1.0/apps/{schema}/users）。IoT 平台 → App → 渠道标识符。
# mock 可填任意非空如 mock；live 必须填真实 schema。
TUYA_APP_SCHEMA=fogattiandroidletsmart
# live 才需要（与 OpenAPI 同一对 Access ID / Secret 即可）
TUYA_PULSAR_ACCESS_ID=
TUYA_PULSAR_ACCESS_KEY=
# 消息订阅环境：prod=生产（out/event），test=测试（out/event-test）
TUYA_MQ_ENV=prod
# 可选：cn|us|eu|in，或直接覆盖 WebSocket 基址
# TUYA_MQ_REGION=cn
# TUYA_MQ_WS_URL=wss://mqe.tuyacn.com:8285/
# 控制台显示 AES-GCM 时默认 aes_gcm；旧项目可改 aes_ecb
TUYA_MQ_ENCRYPT=aes_gcm

KAFKA_BROKERS=127.0.0.1:19092
KAFKA_TOPIC_DEVICE_EVENTS=tuya.device.events
KAFKA_GROUP_ID=tuya-ops-demo

# System health page (/system-health). Event age above this is stale (ms, default 15 min).
SYSTEM_HEALTH_STALE_EVENT_MS=900000
# Consumer-group lag above these lines marks Kafka 消费 yellow / red.
SYSTEM_HEALTH_KAFKA_LAG_WARN=100
SYSTEM_HEALTH_KAFKA_LAG_CRIT=1000

OFFLINE_ALERT_MINUTES=10
# Raw DeviceEvent / CommandLog / AuditLog / closed Alert retention (days).
# DailyDeviceMetric / DailyFaultStat / OpsReport rollups are not purged.
RETENTION_DAYS=90
# Hot DeviceEvent window. Older rows move into DeviceEventArchive (monthly partitions).
# EVENT_HOT_DAYS=14
# Retention deletes in batches so one statement does not lock the whole event table.
# RETENTION_BATCH_SIZE=1000
# Stop the run if one batch holds locks longer than this. A dry-run only counts.
# RETENTION_BATCH_LOCK_BUDGET_MS=2000
# RETENTION_DRY_RUN=true
# Optional: run analytics rollup once on API start
# ANALYTICS_ROLLUP_ON_START=true

# Scheduled jobs (offline / retention / rollup) run inside this API process.
# 禁止多副本跑 job: there is no distributed lock.
# Keep JOBS_ENABLED=true on exactly one API. Every extra replica must set false.
# JOBS_ENABLED=true
# Optional one-shot retention on boot (still gated by JOBS_ENABLED).
# RETENTION_RUN_ON_START=true

# Kafka consumer. One partition stays in offset order (key=deviceId).
# Other partitions run concurrently up to this cap.
# KAFKA_PARTITIONS_CONCURRENCY=4
# Total handler attempts per chunk, then skip-and-continue. See docs/runbooks/phase-b-ingest.md.
# KAFKA_MESSAGE_RETRIES=3
# KAFKA_MESSAGE_RETRY_MS=200
# KAFKA_HANDLER_BATCH=32
# Soft-cap count(*) is cached for this long, then recalibrated. Not a hard stop.
# DEVICE_COUNT_CALIBRATE_MS=60000

# Bridge keepalive. One path: ping, pong deadline, stale watchdog.
# TUYA_MQ_PING_INTERVAL_MS=30000
# TUYA_MQ_PONG_TIMEOUT_MS=10000
# TUYA_MQ_STALE_MS=90000

API_PORT=3000
WEB_ORIGIN=http://localhost:5173
